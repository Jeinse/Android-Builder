        "AR":"llvm-ar",
        "NM": "llvm-nm",
        "OBJCOPY": "llvm-objcopy",
        "OBJDUMP": "llvm-objdump",
        "STRIP": "llvm-strip"
      }
    },
    "AnyKernel3": {
      "use": false,
      "release": true,
      "custom": {
        "repo": "",
        "branch": ""
      }
    },
    "enableKernelSU": false,
    "enableLXC": false
  }
